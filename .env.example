# =====================================================================
# THIÊN SƠN EPOXY - AI AGENTIC ENVIRONMENT CONFIGURATION
# =====================================================================
# Lưu ý: Sao chép file này thành .env và điền các khóa bí mật.
# Tuyệt đối không commit file .env chứa giá trị thật lên Git!

# 1. GITHUB PERSONAL ACCESS TOKEN (PAT)
# Dùng để đồng bộ và push code/agentic workflow lên repository GitHub
# Link tạo: https://github.com/settings/tokens (chọn repo permission)
GITHUB_TOKEN=

# 2. GOOGLE GEMINI API KEY
# Dùng cho các tác vụ mô hình ngôn ngữ lớn của Google
# Link tạo: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. OPENAI API KEY (Tùy chọn)
# Link tạo: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 4. ANTHROPIC API KEY (Tùy chọn)
# Link tạo: https://console.anthropic.com/
ANTHROPIC_API_KEY=
